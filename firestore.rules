/**
 * @fileoverview Firestore Security Rules for StudyAI application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data
 * (learning paths, progress, recommendations) and provides public read access
 * to learning resources. Authorization is path-based, eliminating the need
 * for costly `get()` calls.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user.
 * - /users/{userId}/learningPaths/{learningPathId}: Stores learning paths, accessible only to the user.
 * - /users/{userId}/progress/{progressId}: Stores progress data, accessible only to the user.
 * - /resources/{resourceId}: Stores learning resources, publicly readable.
 * - /users/{userId}/recommendations/{recommendationId}: Stores recommendations, accessible only to the user.
 *
 * Key Security Decisions:
 * - Users can only access their own data (profile, learning paths, progress, recommendations).
 * - Learning resources are publicly readable but writes are not allowed in this prototype.
 * - Listing operations are restricted to owners for user-scoped subcollections.
 *
 * Denormalization for Authorization:
 * - User-specific data (learning paths, progress, recommendations) includes a `userId` field that
 *   must match the `userId` in the path. This denormalization enables path-based authorization and avoids `get()` calls.
 *
 * Structural Segregation:
 * - User-specific data and global data are stored in separate collections, allowing for different
 *   security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     *   request.auth.uid == 'user123' && request.resource.data.id == 'user123'
     * @allow (get, update, delete) User with ID 'user123' can read, update, and delete their profile.
     *   request.auth.uid == 'user123'
     * @deny (create) User with ID 'user456' cannot create a profile for 'user123'.
     *   request.auth.uid == 'user456' && request.resource.data.id == 'user123'
     * @deny (update, delete) User with ID 'user456' cannot update or delete 'user123's profile.
     *   request.auth.uid == 'user456'
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id; // Enforce immutability of userId
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to learning paths for a specific user.
     * @path /users/{userId}/learningPaths/{learningPathId}
     * @allow (create) User with ID 'user123' can create a learning path under their profile.
     *   request.auth.uid == 'user123' && request.resource.data.userId == 'user123'
     * @allow (get, update, delete) User with ID 'user123' can read, update, and delete their learning paths.
     *   request.auth.uid == 'user123'
     * @deny (create) User with ID 'user456' cannot create a learning path for 'user123'.
     *   request.auth.uid == 'user456' && request.resource.data.userId == 'user123'
     * @deny (update, delete) User with ID 'user456' cannot update or delete 'user123's learning paths.
     *   request.auth.uid == 'user456'
     * @principle Enforces document ownership for learning paths.
     */
    match /users/{userId}/learningPaths/{learningPathId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
        function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId; // Enforce immutability of userId
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to progress entries for a specific user.
     * @path /users/{userId}/progress/{progressId}
     * @allow (create) User with ID 'user123' can create a progress entry under their profile.
     *   request.auth.uid == 'user123' && request.resource.data.userId == 'user123'
     * @allow (get, update, delete) User with ID 'user123' can read, update, and delete their progress entries.
     *   request.auth.uid == 'user123'
     * @deny (create) User with ID 'user456' cannot create a progress entry for 'user123'.
     *   request.auth.uid == 'user456' && request.resource.data.userId == 'user123'
     * @deny (update, delete) User with ID 'user456' cannot update or delete 'user123's progress entries.
     *   request.auth.uid == 'user456'
     * @principle Enforces document ownership for progress entries.
     */
    match /users/{userId}/progress/{progressId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId; // Enforce immutability of userId
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to learning resources.
     * @path /resources/{resourceId}
     * @allow (get, list) Any user can read the resources.
     *   true
     * @deny (create, update, delete) No user can create, update, or delete resources in this prototype.
     *   false
     * @principle Allows public read access to learning resources.
     */
    match /resources/{resourceId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add role-based write access for admins in a later iteration
    }

    /**
     * @description Controls access to recommendations for a specific user.
     * @path /users/{userId}/recommendations/{recommendationId}
     * @allow (create) User with ID 'user123' can create a recommendation under their profile.
     *   request.auth.uid == 'user123' && request.resource.data.userId == 'user123'
     * @allow (get, update, delete) User with ID 'user123' can read, update, and delete their recommendations.
     *   request.auth.uid == 'user123'
     * @deny (create) User with ID 'user456' cannot create a recommendation for 'user123'.
     *   request.auth.uid == 'user456' && request.resource.data.userId == 'user123'
     * @deny (update, delete) User with ID 'user456' cannot update or delete 'user123's recommendations.
     *   request.auth.uid == 'user456'
     * @principle Enforces document ownership for recommendations.
     */
    match /users/{userId}/recommendations/{recommendationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
        function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId; // Enforce immutability of userId
      allow delete: if isExistingOwner(userId);
    }
  }
}